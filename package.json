{
  "name": "watchly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build && vite build",
    "dev": "vite",
    "env:audit": "varlock audit",
    "env:scan": "varlock scan",
    "format": "oxfmt",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "lefthook install",
    "preview": "vite preview",
    "test": "nub --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-fetch/fetch": "^1.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@lorenzopant/tmdb": "^1.25.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.7",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.46",
    "@uidotdev/usehooks": "^2.4.1",
    "@varlock/cloudflare-integration": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2",
    "varlock": "^1.16.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.1",
    "@nubjs/types": "^0.7.5",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/eslint-plugin-query": "^5.102.7",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-query-devtools": "^5.102.7",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "oxc-transform-react": "^0.147.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7",
    "vite": "^8.2.2",
    "wrangler": "^4.127.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.5",
      "onFail": "warn"
    }
  },
  "packageManager": "nub@0.7.5",
  "allowBuilds": {
    "esbuild": true,
    "lefthook": true,
    "workerd": true
  }
}
