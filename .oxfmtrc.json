{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["routeTree.gen.ts"],
  "singleQuote": true,
  "printWidth": 120,
  "sortTailwindcss": {
    "stylesheet": "./src/index.css",
    "attributes": ["class", "className"],
    "functions": ["clsx", "cn", "cva"]
  },
  "sortPackageJson": {
    "sortScripts": true
  },
  "sortImports": {
    "newlinesBetween": false
  }
}
